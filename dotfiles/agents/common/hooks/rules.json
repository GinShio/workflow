{
	"readAllowlist": [
		"/usr/include", "/usr/src", "/usr/lib", "/usr/lib64", "/usr/share", "/proc", "/sys",
		"/usr/bin", "/usr/sbin", "/usr/local/bin", "/usr/local/include", "/usr/local/lib",
		"/usr/local/lib64", "/usr/local/man", "/usr/local/share", "/bin", "/sbin", "/lib", "/lib64",
		"/etc/os-release",
		"/dev/null", "/dev/stdin", "/dev/stdout", "/dev/stderr", "/dev/tty",
		"/dev/zero", "/dev/urandom", "/dev/random",
		"{{@@ env['XDG_RUNTIME_DIR'] @@}}/claude",
		"{{@@ env['XDG_RUNTIME_DIR'] @@}}/codex",
		"{{@@ env['XDG_RUNTIME_DIR'] @@}}/cursor",
		"{{@@ env['XDG_RUNTIME_DIR'] @@}}/pi"
	],
	"writeExemptPrefixes": [
		"{{@@ env['XDG_RUNTIME_DIR'] @@}}/claude",
		"{{@@ env['XDG_RUNTIME_DIR'] @@}}/codex",
		"{{@@ env['XDG_RUNTIME_DIR'] @@}}/cursor",
		"{{@@ env['XDG_RUNTIME_DIR'] @@}}/pi",
		"/dev/null", "/dev/stdout", "/dev/stderr", "/dev/tty"
	],
	"unattended": {
		"timeoutMs": 180000,
		"allow": []
	},
	"classes": [
		{
			"id": "git-metadata",
			"action": "deny",
			"reason": "Destroys repository history beyond recovery — stop and report if the task seems to require removal.",
			"bash": [
				"\\brm\\s+[^;&|]*\\.git\\b",
				"\\brm\\s+[^;&|]*-\\w*[rf][^;&|]*\\s[\"']?\\.{1,2}/?[\"']?(\\s|$)"
			]
		},
		{
			"id": "git-integrate",
			"action": "deny",
			"reason": "Integrate upstream: git fetch, then git merge --ff-only FETCH_HEAD; if it can't fast-forward, report the divergence.",
			"bash": [
				"{{git}}\\bpull(?![.\\w-])(?![^;&|]*--ff-only)",
				"{{git}}\\bmerge(?![.\\w-])(?![^;&|]*(?:--ff-only|--abort))"
			]
		},
		{
			"id": "git-publish",
			"action": "deny",
			"reason": "Publishing and remote changes are the user's actions — hand the exact command to the user and wait for them to run it.",
			"bash": [
				"{{git}}\\bpush(?![.\\w-])",
				"{{git}}\\bremote\\s+(add|rename|remove|rm|set-url|set-head|prune)\\b"
			]
		},
		{
			"id": "registry-publish",
			"action": "deny",
			"reason": "Publishing to a registry or image index is the user's action — hand the exact command to the user and wait for them to run it.",
			"bash": [
				"\\b(npm|pnpm|yarn)\\s+publish\\b",
				"\\bcargo\\s+publish\\b",
				"\\bgem\\s+push\\b",
				"\\btwine\\s+upload\\b",
				"\\bpoetry\\s+publish\\b",
				"\\b(docker|podman)\\s+push\\b"
			]
		},
		{
			"id": "git-recovery-destroy",
			"action": "deny",
			"reason": "Destroys git's recovery paths — unrecoverable afterward; hand the exact command to the user and wait.",
			"bash": [
				"{{git}}\\bstash\\s+clear\\b",
				"{{git}}\\breflog\\s+(expire|delete)\\b",
				"{{git}}\\bgc\\b[^;&|]*--prune\\b",
				"{{git}}\\bworktree\\s+remove\\b[^;&|]*(?:--force\\b|\\s-f\\b)"
			]
		},
		{
			"id": "git-rewrite",
			"action": "deny",
			"reason": "Rewrites what every clone depends on — hand the exact command to the user and wait.",
			"bash": [
				"{{git}}\\bfilter-(branch|repo)(?![.\\w-])",
				"{{git}}\\breplace(?![.\\w-])",
				"{{git}}\\bupdate-ref(?![.\\w-])"
			]
		},
		{
			"id": "secret-dirs",
			"action": "deny",
			"reason": "Credential and key stores — never read, list, or write them; route anything needing their contents to the user.",
			"secretNames": {
				"segments": [".ssh", ".gnupg", ".aws", ".kube"]
			}
		},
		{
			"id": "secret-files",
			"action": "ask",
			"reason": "Path looks like secret material — state why the task needs it.",
			"secretNames": {
				"names": [".env", ".env.local", ".env.*.local", ".env.production", ".env.staging", ".env.development", "*.pem", "*.key", "*.p12", "*.pfx", "id_rsa", "id_ed25519", "id_ecdsa", "auth.json", "credentials.json", "credentials*.json", "*.token", ".netrc", ".npmrc", ".pypirc", "secrets*"]
			}
		},
		{
			"id": "privacy-store",
			"action": "deny",
			"reason": "Private state — if the task genuinely needs it, state what and why, and wait for the user.",
			"pathKind": "any",
			"underPrefixes": [
				"~/.config/gnupg",
				"~/.local/share/kwalletd", "~/.local/share/keyrings",
				"~/.mozilla", "~/.thunderbird",
				"~/.steam", "~/.local/share/Steam",
				"~/.bash_history", "~/.local/share/fish/fish_history", "~/.local/share/atuin", "~/.viminfo",
				"/etc/ssh", "/etc/sudoers", "/etc/sudoers.d", "/etc/shadow", "/etc/gshadow"
			]
		},
		{
			"id": "git-discard",
			"action": "ask",
			"reason": "Discards uncommitted or local-only state — irrecoverable; state exactly what would be discarded and wait.",
			"bash": [
				"{{git}}\\brestore(?![.\\w-])",
				"{{git}}\\bcheckout\\b[^;&|]*\\s--\\s",
				"{{git}}\\bstash\\s+drop\\b",
				"{{git}}\\bbranch\\b[^;&|]*\\s-D\\b",
				"{{git}}\\btag\\s+(-d|--delete)\\b",
				"{{git}}\\bworktree\\s+remove\\b",
				"{{git}}\\bsubmodule\\s+(deinit|rm|remove)\\b",
				"{{git}}\\bswitch\\b[^;&|]*--discard-changes\\b"
			]
		},
		{
			"id": "git-side-effects",
			"action": "ask",
			"reason": "Repo-state changes — the user's call; state what you intend and wait — a decline is a stop, not a prompt to rephrase.",
			"bash": [
				"{{git}}\\bcommit(?![.\\w-])(?![^;&|]*--dry-run)",
				"{{git}}\\b(?:rebase|cherry-pick)(?![.\\w-])(?![^;&|]*--abort)",
				"{{git}}\\brevert(?![.\\w-])",
				"{{git}}\\breset\\b[^;&|]*--hard\\b",
				"{{git}}\\bclean(?![.\\w-])(?![^;&|]*(?:-n(?![.\\w-])|--dry-run))",
				"\\b(gh|glab)\\s+(pr|mr|repo|release)\\b[^;&|]*\\b(create|merge|close|delete|edit|submit)\\b"
			]
		},
		{
			"id": "machine-lifecycle",
			"action": "deny",
			"reason": "Machine power state is the user's action — if the task needs it, say so and stop.",
			"bash": [
				"\\b(shutdown|reboot|halt|poweroff)\\b",
				"\\binit\\s+[06]\\b"
			]
		},
		{
			"id": "storage-destructive",
			"action": "deny",
			"reason": "Destroys data beyond any recovery — hand the exact command to the user and wait.",
			"bash": [
				"\\bmkfs(?:\\.\\w+)?\\b",
				"\\bdd\\b[^;&|]*\\bof=/dev/",
				"\\b(wipefs|blkdiscard)\\b",
				"\\b(zpool|zfs)\\s+[^;&|]*\\b(destroy|remove)\\b",
				"\\b(pvremove|vgremove|lvremove)\\b",
				"\\bmdadm\\b[^;&|]*--zero-superblock\\b",
				"\\bsgdisk\\b[^;&|]*--zap\\b",
				"\\bparted\\b[^;&|]*\\b(mklabel|mkfs|rm)\\b",
				"\\bvirsh\\b[^;&|]*\\b(destroy|undefine|vol-delete|vol-wipe|snapshot-delete|managedsave-remove)\\b"
			]
		},
		{
			"id": "container-machine",
			"action": "deny",
			"reason": "Reaches past the container boundary to the host — hand the exact command to the user and wait.",
			"bash": [
				"\\b(docker|podman|nerdctl)\\b[^;&|]*\\b(?:system\\s+)?prune\\b",
				"\\b(docker|podman)\\s+compose\\b[^;&|]*\\bdown\\b[^;&|]*\\s(?:-v\\b|--volumes\\b)",
				"\\bdocker-compose\\b[^;&|]*\\bdown\\b[^;&|]*\\s(?:-v\\b|--volumes\\b)",
				"\\b(docker|podman|nerdctl)\\b[^;&|]*\\brun\\b[^;&|]*--privileged\\b"
			]
		},
		{
			"id": "container-destructive",
			"action": "ask",
			"reason": "Can destroy data — volumes may not survive; state what is removed and what remains recoverable.",
			"bash": [
				"\\b(docker|podman|nerdctl)\\b[^;&|]*\\b(rm|rmi)\\b",
				"\\b(docker|podman)\\s+compose\\b[^;&|]*\\bdown\\b",
				"\\bdocker-compose\\b[^;&|]*\\bdown\\b"
			]
		},
		{
			"id": "destructive-ops",
			"action": "ask",
			"reason": "Destructive or irreversible — state exactly what it destroys and wait.",
			"bash": [
				"\\bdd\\b[^;&|]*\\bof=(?!/dev/)",
				"\\b(chmod|chown)\\b[^;&|]*\\s(-R|--recursive)\\b",
				"\\b(pkill|killall)\\b",
				"\\bkill\\b\\s+-[69]\\b"
			]
		},
		{
			"id": "destructive-rm",
			"action": "ask",
			"reason": "Irreversible deletion outside the workspace (inside it, git is the recovery path) — state what it deletes and wait.",
			"bash": [
				"\\brm\\s+[^;&|]*-\\w*[rf]",
				"\\bfind\\b[^;&|]*\\s-delete\\b"
			],
			"bashScope": "external"
		},
		{
			"id": "archive-extract",
			"action": "ask",
			"reason": "Writes wherever the archive's entry paths point — extract into a fresh directory, never /.",
			"bash": [
				"\\b(?:bsd)?tar\\s+x[zjJvf]*(\\s|$)",
				"\\b(?:bsd)?tar\\s+[^;&|]*\\s?(-x[zjJvf]*|--extract|--get)\\b",
				"\\b(unzip|unrar|unar)\\b",
				"\\b7z\\s+[xe]\\b"
			]
		},
		{
			"id": "remote-exec",
			"action": "deny",
			"reason": "Runs unreviewed code — download, inspect, then propose the install; prefer distro packages.",
			"bash": [
				"\\b(curl|wget)\\b[^;&|]*\\|\\s*(sudo\\s+)?((?:ba|z|da|k|a)?sh|fish|python3?|\\$\\{?[A-Za-z_]\\w*\\}?)\\b",
				"\\b(source|bash|zsh|dash|ksh|sh|fish)\\s+<\\(\\s*(curl|wget)"
			]
		},
		{
			"id": "network-transfer",
			"action": "ask",
			"reason": "Moves data to another host — state the source, the destination, and exactly what moves.",
			"bash": [
				"\\b(curl|wget)\\b(?![^;&|]*(localhost|127\\.0\\.0\\.1|::1|\\[::1\\]))",
				"\\b(gh|glab)\\s+api\\b",
				"\\brsync\\b[^;&|]*\\S+:",
				"\\b(scp|sftp)\\b",
				"\\bssh(?![.\\w-])",
				"\\b(nc|socat|telnet)\\b"
			]
		},
		{
			"id": "persistence-change",
			"action": "ask",
			"reason": "Changes what runs on this machine, now or at boot — state what changes, why the workspace cannot hold it, and how to revert.",
			"bash": [
				"\\bcrontab\\b(?![^;&|]*-l\\b)",
				"\\bsystemctl\\b[^;&|]*\\b(enable|disable|mask|unmask|link|preset|start|stop|restart|try-restart|reload)\\b"
			]
		},
		{
			"id": "package-mutate",
			"action": "deny",
			"reason": "Dependency changes are the user's decision — only exact restores from pinned config pass; anything else, hand the exact command to the user and wait.",
			"bash": [
				"\\b(apt|apt-get)\\s+(install|upgrade|full-upgrade|dist-upgrade|remove|purge|autoremove)\\b",
				"\\bdnf\\s+(install|upgrade|update|downgrade|reinstall|remove|erase|autoremove)\\b",
				"\\bzypper\\s+(install|in|up|update|dup|remove|rm)\\b",
				"\\b(pacman|yay|paru|pikaur)\\s+[^;&|]*-[A-Za-z]*(?:S(?!s)|R)",
				"\\bapk\\s+(add|del)\\b",
				"\\bemerge\\b",
				"\\bbrew\\s+(install|upgrade|reinstall|uninstall|remove)\\b",
				"\\bsnap\\s+(install|refresh|remove)\\b",
				"\\bflatpak\\s+(install|update|uninstall|remove)\\b",
				"\\bpip3?\\s+install\\b(?![^;&|]*\\s(-r|--requirement)\\s)",
				"\\bpip3?\\s+uninstall\\b",
				"\\buv\\s+pip\\s+install\\b(?![^;&|]*\\s(-r|--requirement)\\s)",
				"\\buv\\s+pip\\s+(uninstall|remove)\\b",
				"\\buv\\s+(add|tool\\s+(install|uninstall|upgrade|reinstall))\\b",
				"\\bpoetry\\s+(add|remove|update)\\b",
				"\\b(conda|mamba)\\s+(install|remove|uninstall|update|upgrade)\\b",
				"\\bgem\\s+(install|uninstall|update|upgrade)\\b",
				"\\bcargo\\s+(install|uninstall|add|remove)\\b",
				"\\bgo\\s+(install|get)\\b",
				"\\bdeno\\s+(install|uninstall|add|remove|update)\\b",
				"\\b(npm|pnpm|bun)\\s+(install|i|add)\\b[^;&|>]*\\s[a-zA-Z@]",
				"\\b(npm|pnpm|yarn|bun)\\s+(install|i|add)\\b[^;&|]*\\s(?:-g(?![\\w-])|--global(?![\\w-]))",
				"\\byarn\\s+global\\s+(add|remove)\\b",
				"\\byarn\\s+(add|remove)\\b",
				"\\byarn\\s+install\\b[^;&|>]*\\s[a-zA-Z@]",
				"\\b(npm|pnpm|bun)\\s+(uninstall|remove|rm)\\b"
			]
		},
		{
			"id": "package-run",
			"action": "ask",
			"reason": "Downloads and runs unreviewed code — prefer a project dependency or an installed tool.",
			"bash": [
				"\\b(npx|bunx|uvx)\\b",
				"\\b(pnpm|yarn)\\s+dlx\\b",
				"\\bpipx\\s+run\\b",
				"\\bnpm\\s+exec\\b"
			]
		},
		{
			"id": "system-privileged",
			"action": "deny",
			"reason": "Agents never run commands as another user or root — state the exact command and why it needs privilege; the user runs it themselves.",
			"bash": [
				"\\bsudo\\b",
				"\\bdoas\\b"
			]
		},
		{
			"id": "test-deletion",
			"action": "ask",
			"reason": "Tests are the suite's contract — deleting them is never the fix.",
			"bash": [
				"\\b(git\\s+)?rm\\b[^;&|]*(__tests__|/tests?/|\\.test\\.|\\.spec\\.|_test\\.[a-z]+|test_[^/\\s]*\\.py)"
			],
			"bashScope": "external"
		},
		{
			"id": "tmp-dirs",
			"action": "deny",
			"reason": "Shared with every process on the machine — put scratch in $TMPDIR instead.",
			"pathKind": "any",
			"underPrefixes": ["/tmp", "/var/tmp", "/dev/shm"]
		},
		{
			"id": "tree-external-write",
			"action": "ask",
			"reason": "Outside the workspace — state the target and why it cannot live in the tree.",
			"pathKind": "write",
			"outside": "project"
		},
		{
			"id": "read-scope",
			"action": "ask",
			"reason": "Outside the agreed read scope — state what you need from it.",
			"pathKind": "read",
			"allowPrefixes": [
				"~/Projects",
				"~/.agents",
				"~/.claude", "~/.claude.json",
				"~/.codex",
				"~/.cursor",
				"~/.config/pi"
			]
		}
	]
}
