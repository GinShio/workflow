{
  "env": {
    "TMPDIR": "{{@@ env['XDG_RUNTIME_DIR'] @@}}/claude"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|Read|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/hooks/guard.ts",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
