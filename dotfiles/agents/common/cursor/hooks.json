{
	"version": 1,
	"hooks": {
		"beforeShellExecution": [
			{
				"command": "node $HOME/.cursor/hooks/guard.ts",
				"timeout": 15,
				"failClosed": true
			}
		],
		"beforeMCPExecution": [
			{
				"command": "node $HOME/.cursor/hooks/guard.ts",
				"timeout": 15,
				"failClosed": true
			}
		],
		"beforeReadFile": [
			{
				"command": "node $HOME/.cursor/hooks/guard.ts",
				"timeout": 15,
				"failClosed": true
			}
		],
		"preToolUse": [
			{
				"command": "node $HOME/.cursor/hooks/guard.ts",
				"matcher": "^(Write|Delete|StrReplace)$",
				"timeout": 15,
				"failClosed": true
			},
			{
				"command": "node $HOME/.cursor/hooks/tmpdir.ts {{@@ env['XDG_RUNTIME_DIR'] @@}}/cursor",
				"matcher": "^Shell$",
				"timeout": 15
			}
		]
	}
}
