# Tangled output.  The tracked early-init.el and init.el are fail-closed
# loaders; config.org and org/*.org generate their payloads below.
# Other modules/ subdirectories contain tracked upstream sources and assets.
/modules/ginshio/
/.ginshio-tangle-*/

# Package manager and generated state.  The straight data tree and activations
# live under $XDG_DATA_HOME/emacs/, so anything appearing here means a redirect
# failed.  eln-cache is not anchored: native compilation puts it beside whatever
# root it took for the configuration directory.
eln-cache/
/var/
/.custom.el
/.local/

######################### Emacs #########################
*~
\#*\#
.\#*
*.elc
auto-save-list
tramp
.org-id-locations
*_archive
*_flymake.*
