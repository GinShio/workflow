# Tangled output.  config.org and org/*.org are the source of truth; the
# Ginshio Lisp subtree is regenerated by `emacs --batch -l tangle.el'.
# Other lisp/ subdirectories contain tracked upstream sources.
/early-init.el
/init.el
/lisp/ginshio/

# Package manager and generated state.  These are redirected to XDG data/cache
# directories, so anything appearing here means a redirect failed.  eln-cache is
# not anchored: native compilation puts it beside whatever it took for the
# configuration directory, which is not always the top of this tree.
/elpaca/
eln-cache/
/var/
/.custom.el

