#!/usr/bin/env bash

set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
emacs_bin=${EMACS:-emacs}

die() {
  printf 'ginshio-emacs: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

require_xdg() {
  local value variable
  for variable in \
    XDG_CONFIG_HOME \
    XDG_DATA_HOME \
    XDG_STATE_HOME \
    XDG_CACHE_HOME \
    XDG_RUNTIME_DIR
  do
    value=${!variable:-}
    [[ -n $value ]] || die "required environment variable is not set: $variable"
    [[ $value == /* ]] || die "required environment variable is not absolute: $variable=$value"
  done
  [[ -d $XDG_RUNTIME_DIR ]] || die "XDG_RUNTIME_DIR does not exist: $XDG_RUNTIME_DIR"
  [[ -w $XDG_RUNTIME_DIR ]] || die "XDG_RUNTIME_DIR is not writable: $XDG_RUNTIME_DIR"
  [[ $(stat -c '%a' "$XDG_RUNTIME_DIR") == 700 ]] ||
    die "XDG_RUNTIME_DIR must be private (0700): $XDG_RUNTIME_DIR"
}

tangle() {
  require_command "$emacs_bin"
  "$emacs_bin" -Q --batch -l "$root/tangle.el"
}

# Load the full configuration in a single batch process.  A command is
# injected through GINSHIO_EMACS_COMMAND so the package module knows
# whether to maintain (`sync' / `rebuild' / `upgrade'), to validate every
# declared feature (`validate'), or to act as an ordinary consumer (no
# variable).
#
# Package installs are deterministic batch work; they must not trip over
# interactive or machine-specific git hooks.  `core.hooksPath=/dev/null'
# disables every hook (including reference-transaction) for the commands
# straight runs, while keeping the rest of the user's git environment.
batch_config() {
  GIT_CONFIG_COUNT=1 \
  GIT_CONFIG_KEY_0=core.hooksPath \
  GIT_CONFIG_VALUE_0=/dev/null \
  env GINSHIO_EMACS_COMMAND="$1" \
    "$emacs_bin" -Q --batch \
    --init-directory="$root" \
    -l "$root/early-init.el" \
    -l "$root/init.el" \
    "${@:2}"
}

# An upgrade needs a second maintenance process.  Rebuilding has to happen
# while the configuration declares its packages, and by the time `upgrade'
# has fetched new sources that pass is already over -- so the rebuild runs
# as its own process against the revisions the upgrade just wrote.
manage_packages() {
  local command=$1
  require_command "$emacs_bin"
  require_command git
  require_xdg
  tangle
  batch_config "$command" --eval '(princ "Package graph synchronized.\n")'
  if [[ $command == upgrade ]]; then
    batch_config rebuild --eval '(princ "Package graph rebuilt.\n")'
  fi
  batch_config validate --eval '(princ "Package graph validated.\n")'
}

doctor() {
  require_command "$emacs_bin"
  require_xdg
  tangle
  batch_config validate -f ginshio-doctor-batch
}

# The activation snapshot must go with the package tree it describes: an
# ordinary session checks the snapshot before anything else, so leaving it
# behind would let Emacs start against packages that no longer exist.
clean() {
  local tree_dir native_cache_dir
  require_xdg
  tree_dir="${XDG_DATA_HOME%/}/emacs/straight"
  native_cache_dir="${XDG_CACHE_HOME%/}/emacs/eln-cache"
  rm -rf -- "$root/modules/ginshio" "$tree_dir" "$native_cache_dir"
  rm -f -- "${XDG_DATA_HOME%/}/emacs/activation.el" \
    "${XDG_DATA_HOME%/}/emacs/activation.elc"
  printf 'Removed tangled Lisp, package tree, activation, and native-comp cache.\n'
}

usage() {
  cat <<'EOF'
Usage:
  bin/ginshio-emacs sync [--rebuild | --upgrade]
  bin/ginshio-emacs clean
  bin/ginshio-emacs doctor

Commands:
  sync               Install the packages declared by the configuration at
                     their locked revisions and regenerate the activation
  clean              Remove tangled Lisp, packages, activation, and cache
  doctor             Check the loaded configuration and external dependencies

Sync options (mutually exclusive):
  --rebuild          Rebuild every package at its locked revision, without
                     touching upstream or the lock.  For a build left
                     incomplete or stale, which a plain sync trusts.
  --upgrade          Fetch upstream updates, rebuild, and rewrite the lock

Environment:
  EMACS               Override the Emacs executable
EOF
}

case ${1:-} in
  sync)
    if (( $# == 1 )); then
      manage_packages sync
    elif (( $# == 2 )) && [[ $2 == --rebuild ]]; then
      manage_packages rebuild
    elif (( $# == 2 )) && [[ $2 == --upgrade ]]; then
      manage_packages upgrade
    else
      usage >&2
      die "sync accepts one of --rebuild or --upgrade"
    fi
    ;;
  clean)
    (( $# == 1 )) || die "clean accepts no arguments"
    clean
    ;;
  doctor)
    (( $# == 1 )) || die "doctor accepts no arguments"
    doctor
    ;;
  '')
    usage
    ;;
  help|-h|--help)
    (( $# == 1 )) || die "$1 accepts no arguments"
    usage
    ;;
  *)
    usage >&2
    die "unknown command: $1"
    ;;
esac
