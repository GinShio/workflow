#!/usr/bin/env bash

set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
emacs_bin=${EMACS:-emacs}

die() {
  printf 'vanilla-emacs: %s\n' "$*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

require_xdg() {
  local value variable
  for variable in \
    XDG_CONFIG_HOME \
    XDG_DATA_HOME \
    XDG_STATE_HOME \
    XDG_CACHE_HOME \
    XDG_RUNTIME_DIR
  do
    value=${!variable:-}
    [[ -n $value ]] || die "required environment variable is not set: $variable"
    [[ $value == /* ]] || die "required environment variable is not absolute: $variable=$value"
  done
  [[ -d $XDG_RUNTIME_DIR ]] || die "XDG_RUNTIME_DIR does not exist: $XDG_RUNTIME_DIR"
  [[ -w $XDG_RUNTIME_DIR ]] || die "XDG_RUNTIME_DIR is not writable: $XDG_RUNTIME_DIR"
  [[ $(stat -c '%a' "$XDG_RUNTIME_DIR") == 700 ]] ||
    die "XDG_RUNTIME_DIR must be private (0700): $XDG_RUNTIME_DIR"
}

tangle() {
  require_command "$emacs_bin"
  "$emacs_bin" -Q --batch -l "$root/tangle.el"
}

batch_config() {
  env -u GINSHIO_EMACS_COMMAND \
    "$emacs_bin" -Q --batch \
    --init-directory="$root" \
    -l "$root/early-init.el" \
    -l "$root/init.el" \
    "$@"
}

manage_packages() {
  local candidate_lock command temporary_lock
  command=$1
  require_command "$emacs_bin"
  require_command git
  require_xdg
  tangle
  candidate_lock="${XDG_DATA_HOME%/}/emacs/elpaca/candidate.lock"
  rm -f -- "$candidate_lock"
  env GINSHIO_EMACS_COMMAND="$command" \
    GINSHIO_EMACS_CANDIDATE_LOCK="$candidate_lock" \
    "$emacs_bin" -Q --batch \
    --init-directory="$root" \
    -l "$root/early-init.el" \
    -l "$root/init.el" \
    --eval '(princ "Candidate package generation built.\n")'
  [[ -r $candidate_lock ]] ||
    die "package maintenance did not produce $candidate_lock"
  env GINSHIO_EMACS_COMMAND=validate \
    GINSHIO_EMACS_LOCK_FILE="$candidate_lock" \
    "$emacs_bin" -Q --batch \
    --init-directory="$root" \
    -l "$root/early-init.el" \
    -l "$root/init.el" \
    --eval '(princ "Candidate package generation validated.\n")'
  temporary_lock=$(mktemp "$root/.elpaca.lock.XXXXXX")
  trap 'rm -f -- "${temporary_lock:-}"' RETURN
  cp -- "$candidate_lock" "$temporary_lock"
  chmod --reference="$root/elpaca.lock" "$temporary_lock" 2>/dev/null || chmod 600 "$temporary_lock"
  mv -f -- "$temporary_lock" "$root/elpaca.lock"
  temporary_lock=
  rm -f -- "$candidate_lock"
  trap - RETURN
  printf 'Package graph is synchronized.\n'
}

doctor() {
  require_command "$emacs_bin"
  require_xdg
  tangle
  env GINSHIO_EMACS_COMMAND=validate \
    "$emacs_bin" -Q --batch \
    --init-directory="$root" \
    -l "$root/early-init.el" \
    -l "$root/init.el" \
    -f ginshio-doctor-batch
}

clean() {
  local native_cache_dir package_dir
  require_xdg
  package_dir="${XDG_DATA_HOME%/}/emacs/elpaca"
  native_cache_dir="${XDG_CACHE_HOME%/}/emacs/eln-cache"
  rm -rf -- "$root/lisp/ginshio" "$package_dir" "$native_cache_dir"
  printf 'Removed tangled Lisp, package tree, and native-comp cache.\n'
}

usage() {
  cat <<'EOF'
Usage:
  bin/vanilla-emacs sync [--upgrade]
  bin/vanilla-emacs clean
  bin/vanilla-emacs doctor

Commands:
  sync [--upgrade]   Reproduce the package graph recorded in elpaca.lock
  clean              Remove tangled Lisp, packages, and native-comp cache
  doctor             Check the loaded configuration and external dependencies

Sync option:
  --upgrade          Fetch upstream updates, rebuild, and rewrite elpaca.lock

Environment:
  EMACS               Override the Emacs executable
EOF
}

case ${1:-} in
  sync)
    if (( $# == 1 )); then
      manage_packages sync
    elif (( $# == 2 )) && [[ $2 == --upgrade ]]; then
      manage_packages upgrade
    else
      usage >&2
      die "sync accepts only the optional --upgrade flag"
    fi
    ;;
  clean)
    (( $# == 1 )) || die "clean accepts no arguments"
    clean
    ;;
  doctor)
    (( $# == 1 )) || die "doctor accepts no arguments"
    doctor
    ;;
  '')
    usage
    ;;
  help|-h|--help)
    (( $# == 1 )) || die "$1 accepts no arguments"
    usage
    ;;
  *)
    usage >&2
    die "unknown command: $1"
    ;;
esac
