#!/bin/sh
# Remove a branch's build directories once no branch carries that name any more.
#
# A rename orphans them exactly as a deletion does: `build_dir` templates key on
# `branch.slug`, so the trees built under the old name are no longer reachable
# from any branch, and the new name resolves somewhere else. Both events are
# therefore handled the same way, which is why this script only needs to know
# that the name is gone, never why.
#
# Guards run before the library for the reason spelled out in 50-cleanup-machete.

[ "$1" = "committed" ] || exit 0

. "$HOOKS_DIR/core/lib.sh"

# Fork-free once the runner has warmed the config, so it stays ahead of the work.
cfg_bool wits.hooks.reference-transaction.cleanup-build-dir-enable || exit 0

deletions=$(branch_deletions)
[ -n "$deletions" ] || exit 0

while read -r branch _old_sha; do
    [ -n "$branch" ] || continue

    # Across every project the branch identified a build in, not just the one
    # that owns the checkout: a borrowed component is the build identity of each
    # project that focuses on it, and those trees are orphaned by this too.
    # branch_build_dirs has already dropped anything unsafe to delete.
    build_dirs=$(branch_build_dirs "$branch" || true)
    oldifs=$IFS
    IFS=$LF
    set -f
    for build_dir in $build_dirs; do
        if rm -rf -- "$build_dir"; then
            log_warn "cleanup-build-dir: removed $build_dir"
        else
            log_warn "cleanup-build-dir: failed to remove $build_dir"
        fi
    done
    IFS=$oldifs
    set +f
done <<_DELETIONS_EOF
$deletions
_DELETIONS_EOF

# Advisory, like every reference-transaction script: see 50-cleanup-machete.
exit 0
