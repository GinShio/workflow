#!/bin/sh
# Remove a branch's build directory when the branch is deleted.

. "$HOOKS_DIR/core/lib.sh"

cfg_bool wits.hooks.reference-transaction.cleanup-build-dir-enable || exit 0

# Only act once the refs are actually written (see cleanup-machete for details).
[ "$1" = "committed" ] || exit 0

# stdin: <old-sha> <new-sha> <ref-name>. A new-sha of all-zero means deletion.
while read -r old_sha new_sha ref_name; do
    [ "$new_sha" = "$NULL_SHA" ] || continue
    case "$ref_name" in
        refs/heads/*) branch=${ref_name#refs/heads/} ;;
        *) continue ;;
    esac

    build_dirs=$(resolve_build_dirs "$branch" || true)
    oldifs=$IFS
    IFS='
'
    set -f
    for build_dir in $build_dirs; do
        if rm -rf -- "$build_dir"; then
            log_info "cleanup-build-dir: removed $build_dir"
        else
            log_warn "cleanup-build-dir: failed to remove $build_dir"
        fi
    done
    IFS=$oldifs
    set +f
done
