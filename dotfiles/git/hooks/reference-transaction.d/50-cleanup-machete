#!/bin/sh
# Keep the git-machete forest in step with the branches git just renamed or
# deleted, so the stack never names a branch that is no longer there.
#
# Guards run before the library on purpose. reference-transaction fires three
# times per transaction and once per transaction a rebase or fetch produces,
# while this script has work only on a committed branch deletion. Sourcing
# core/lib.sh costs a parse of the whole library and each repo fact below it
# costs a `git` subprocess, so both wait behind the cheap tests.

# reference-transaction runs up to three times per transaction:
#   prepared  - refs locked, not yet written
#   committed - refs written (the only state we act on)
#   aborted   - transaction rolled back
# Acting on any other state would corrupt the file mid-rebase/restack.
[ "$1" = "committed" ] || exit 0

. "$HOOKS_DIR/core/lib.sh"

# wits owns the machete format, and there is deliberately no second
# implementation of it here: a shell rewrite of the same tree algebra is a copy
# to keep in step with the real one, and the failure mode of a stale copy is a
# silently mangled stack. Without wits this hook does nothing.
command -v wits >/dev/null 2>&1 || exit 0

# Costs no subprocess, so it is the right thing to ask first: the overwhelming
# majority of fires update a tip and delete nothing.
deletions=$(branch_deletions)
[ -n "$deletions" ] || exit 0

if rebase_in_progress; then
    exit 0
fi

git_common_dir
[ -f "$GIT_COMMON_DIR/machete" ] || exit 0

# Split the certain deletions from the ones that may be renames. A rename keeps
# the work, the place in the stack and the MR — only the name changed — so
# dropping its entry would throw away the one record of where that line of work
# sat. The new name cannot be learned here (see may_be_rename), so the entry is
# left standing and the user is told which verb finishes the job.
removals=""
suspects=""
while read -r branch old_sha; do
    [ -n "$branch" ] || continue
    if may_be_rename "$old_sha"; then
        suspects="${suspects:+$suspects }$branch"
    else
        removals="${removals:+$removals }$branch"
    fi
done <<_DELETIONS_EOF
$deletions
_DELETIONS_EOF

# One call for the removals — `git branch -d a b c` is a single transaction, and
# each wits invocation re-reads the project registry and takes the forest lock.
# Word-splitting is intentional, to pass one argument per branch.
if [ -n "$removals" ]; then
    # shellcheck disable=SC2086
    wits stack tree rm $removals ||
        log_warn "cleanup-machete: could not remove deleted branches from the stack."
fi

for branch in $suspects; do
    log_warn "cleanup-machete: '$branch' is gone but kept its commit — likely renamed. Its stack entry was left in place; \`wits stack tree rename $branch <new-name>\` follows it, \`wits stack tree prune\` drops it."
done

# This hook is advisory: the refs are already written, and bookkeeping that could
# not be done must not abort the chain under the runner's fail-fast rule. The
# explicit status also keeps a suppressed log_warn (which returns non-zero when
# the log level hides it) from becoming this script's exit code.
exit 0
