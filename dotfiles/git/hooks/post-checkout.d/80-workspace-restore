#!/bin/sh
# On branch switch, point ./compile_commands.json at the active branch's build
# directory, so tooling picks up the right index.

. "$HOOKS_DIR/core/lib.sh"

# post-checkout args: <prev_head> <new_head> <branch_flag>
[ "$3" = "1" ] || exit 0

branch=$(git symbolic-ref --short HEAD 2>/dev/null)
[ -n "$branch" ] || exit 0   # detached HEAD: nothing to activate

build_dir=$(active_build_dir "$branch") || exit 0
[ -n "$build_dir" ] || exit 0

src="$build_dir/compile_commands.json"
link="$GIT_TOPLEVEL/compile_commands.json"

# Only manage the path if it is absent or a symlink we own; never clobber a real
# file the user committed or generated in-tree.
if [ -e "$link" ] && [ ! -L "$link" ]; then
    log_warn "compile_commands.json is a real file; leaving it untouched."
    exit 0
fi

# The link is written whether or not its target exists yet. A checkout runs
# before the branch has been built, so requiring the file would skip the relink
# and leave the *previous* branch's target in place — an index that silently
# describes a different build. Dangling, tooling reports "no compile commands",
# and the link starts working the moment the build lands, with no second hook
# run to wait for. `-n` so a link that already points at a directory is replaced
# rather than followed into.
ln -sfn "$src" "$link"
log_info "Linked compile_commands.json -> $src"
