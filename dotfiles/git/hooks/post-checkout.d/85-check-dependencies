#!/bin/sh
# Warn (never block) when dependency lockfiles change across a checkout,
# merge, or rewrite, so you remember to re-run your package manager.
# Shared by post-checkout, post-merge and post-rewrite; the post-merge.d and
# post-rewrite.d entries are symlinks to this one.

. "$HOOKS_DIR/core/lib.sh"

case "$HOOK_NAME" in
    post-checkout)
        # args: <prev_head> <new_head> <branch_flag>
        [ "$3" = "1" ] || exit 0
        old="$1"
        new="$2"
        ;;
    post-merge)
        # args: <is_squash>; compare the pre-merge HEAD to the current HEAD.
        old="ORIG_HEAD"
        new="HEAD"
        ;;
    post-rewrite)
        # args: <rewrite-type> ...; stdin lists the rewritten commits as
        # "<old-sha> <new-sha>" pairs, the original branch tip last, so the
        # last line's old sha is what the tree looked like before the rewrite.
        # ORIG_HEAD is not usable here: `git commit --amend` leaves nothing
        # behind, and an earlier merge would leave it pointing elsewhere.
        old=$(awk 'END { print $1 }')
        new="HEAD"
        ;;
    *)
        exit 0
        ;;
esac

# Watched lockfiles, matched by basename anywhere in the tree.
lockfiles="
package-lock.json
deno.lock
yarn.lock
pnpm-lock.yaml
bun.lockb
poetry.lock
uv.lock
Pipfile.lock
requirements.txt
Cargo.lock
go.sum
Gemfile.lock
composer.lock
"

# Single diff; keep paths whose basename is in the watch list.
changed=$(git diff --name-only "$old" "$new" 2>/dev/null | while IFS= read -r path; do
    base=${path##*/}
    for lf in $lockfiles; do
        [ "$base" = "$lf" ] && { printf '%s\n' "$path"; break; }
    done
done)

if [ -n "$changed" ]; then
    log_warn "Dependency lockfiles changed:"
    printf '%s\n' "$changed" | while IFS= read -r f; do log_warn "  $f"; done
    log_warn "You may need to re-run your package manager install."
fi
