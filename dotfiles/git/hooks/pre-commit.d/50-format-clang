#!/bin/sh
. "$HOOKS_DIR/core/lib.sh"

# Format the staged C/C++ changes with clang-format, rewriting the index copy
# via apply_to_staged so unstaged edits are left intact. A missing tool is a
# silent skip.
#
# A file the project already keeps clang-format clean is formatted whole: its
# HEAD version comes out of clang-format unchanged, so a whole-file pass can only
# change what this commit touched. A new file has no history to churn and is
# formatted whole too. Any other file — an upstream one that predates the
# formatter, say — gets only a window around the lines the commit touches, the
# way git-clang-format formats a change: the staged diff's new-side hunks at
# `-U3`. clang-format is fed the whole staged blob, but may only change the lines
# those hunks cover, which takes in three lines around each edit. The widening
# over LLVM's strict `-U0` is deliberate — a reformatted line can otherwise sit
# next to neighbours the edit never touched, and the context window gives the
# formatter room to keep the edited region locally consistent.
#
# clang-format discovers a nearby .clang-format through --assume-filename; an
# explicit configured style overrides that.
command -v clang-format >/dev/null 2>&1 || exit 0

style=$(cfg_value wits.hooks.pre-commit.format-clang-style)

files=$(staged_lang_files .c .h .inc .hh .hpp .hxx .h++ .cc .cpp .cxx .c++ .icc .ipp .ixx .i++ .tcc .tpp .txx)
oldifs=$IFS
IFS='
'
set -f
rc=0
for f in $files; do
    if [ -n "$style" ]; then
        set -- clang-format "--assume-filename=$f" "-style=$style"
    else
        set -- clang-format "--assume-filename=$f" -style=file -fallback-style=LLVM
    fi

    base_formatted "$f" "$@"
    if [ $? -ne 1 ]; then
        apply_to_staged "$f" "$@" || rc=1
        continue
    fi

    # One range per line, and the loop's $IFS is a newline, so the unquoted
    # expansion yields one `--lines` per hunk; clang-format unions overlaps.
    _ranges=$(staged_line_ranges "$f" 3)
    [ -n "$_ranges" ] || continue
    for _range in $_ranges; do
        set -- "$@" "--lines=$_range"
    done
    apply_to_staged "$f" "$@" || rc=1
done
IFS=$oldifs
set +f

exit "$rc"
