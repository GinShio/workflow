#!/bin/sh
. "$HOOKS_DIR/core/lib.sh"

# Bytes, not characters: a text file need not be valid UTF-8 (the encoding check
# judges only added lines), and awk must neither choke on it nor reinterpret it.
LC_ALL=C
export LC_ALL

# Generic whitespace pass for staged text files: trim trailing whitespace from
# the lines this commit adds, and end the file with a newline when its last line
# is one of them. Lines the commit did not touch are left byte for byte, so an
# edit to a file that predates this hook does not drag the rest of it along.
# Language formatters run earlier and leave their files clean, so this is a
# no-op on them; it exists to cover everything else. Binary and encrypted blobs
# are skipped.
#
# Trailing whitespace carries meaning in some formats, so trimming is withheld
# there while the (harmless) final newline is still ensured:
#   - Markdown  — two trailing spaces are a hard line break
#   - CSV / TSV — a trailing tab or space is a delimiter or an empty last field
# and a few formats are byte-exact, so they are left entirely alone:
#   - patch / diff — trimming or appending a newline corrupts the hunks
#
# Trailing whitespace is insignificant in most other markup (LaTeX, HTML, XML,
# reStructuredText: the engine collapses it) so those are trimmed normally; the
# lone exception is verbatim-style blocks (LaTeX verbatim/lstlisting, rST literal
# blocks), where a literal trailing space would be altered — spare such a file by
# adding its extension to the no-trim list.

# Extensions whose trailing whitespace must be preserved (final newline still
# applied). Built-in set plus any the user adds (space-separated).
notrim=".md .markdown .mdown .mkd .mdwn .mkdn .csv .tsv"
notrim="$notrim $(cfg_value wits.hooks.pre-commit.format-generic-notrim)"

# Extensions left completely untouched (content is byte-significant).
skip=".patch .diff"

# Reads the staged blob; `lines` lists the added line numbers, `trim` says
# whether to trim them, `nl` whether the blob already ends with a newline. Each
# line is printed once the next one is seen, so the last can keep a missing
# final newline unless the commit added that line.
program='
BEGIN { n = split(lines, a, ","); for (i = 1; i <= n; i++) added[a[i]] = 1 }
{
    if (NR > 1) printf "%s\n", prev
    prev = $0
    if (trim && (NR in added)) sub(/[ \t]+$/, "", prev)
}
END {
    if (NR == 0) exit
    if (nl || (NR in added)) printf "%s\n", prev
    else printf "%s", prev
}'

oldifs=$IFS
set -f

# The file loop below splits on a newline, the one byte a path may not
# contain. Re-split the extension lists to that separator now, while $IFS is
# still the default — inside the loop a space no longer separates words, and
# each list would match as one literal string that no filename ever ends with.
# shellcheck disable=SC2086
notrim=$(printf '%s\n' $notrim)
# shellcheck disable=SC2086
skip=$(printf '%s\n' $skip)

files=$(staged_files)
[ -n "$files" ] || exit 0
added=$(staged_added_lines)
IFS='
'
rc=0
for f in $files; do
    is_staged_text "$f" || continue
    is_encrypted "$f" && continue

    _leave=0
    for _e in $skip; do
        case "$f" in *"$_e") _leave=1; break ;; esac
    done
    [ "$_leave" = 1 ] && continue

    _lines=$(added_lines_of "$f" "$added")
    [ -n "$_lines" ] || continue

    _trim=1
    for _e in $notrim; do
        case "$f" in *"$_e") _trim=0; break ;; esac
    done

    _nl=0
    [ "$(staged_blob "$f" | tail -c 1 | od -An -tx1 | tr -d ' \n')" = 0a ] && _nl=1

    apply_to_staged "$f" awk -v lines="$_lines" -v trim="$_trim" -v nl="$_nl" "$program" ||
        rc=1
done
IFS=$oldifs
set +f

exit "$rc"
