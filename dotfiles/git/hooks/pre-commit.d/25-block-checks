#!/bin/sh
. "$HOOKS_DIR/core/lib.sh"

# A tripwire you plant in your own code: a stop-word on a line this commit adds
# blocks it until you remove it. Only added lines count, so a file that already
# carries one — documentation naming the markers, say — does not block every
# later edit to it. The literals are split so this file doesn't trip its own
# check.
files=$(staged_files)
[ -n "$files" ] || exit 0

markers="DO_NOT_SUB""MIT|NO""COMMIT|FIXME_BLOC""KER"

hits=$(staged_added_lines | awk -F'\t' -v re="$markers" '$3 ~ re { print $1 ":" $2 ": " $3 }')
[ -z "$hits" ] && exit 0

printf '%s\n' "$hits" >&2
log_error "blocking markers on added lines (above); remove them or commit with --no-verify"
exit 1
