#!/bin/sh
. "$HOOKS_DIR/core/lib.sh"

# Reject the easy-to-make, tedious-to-undo mistakes, judged against the staged
# content: conflict markers on lines this commit adds, symlinks pointing nowhere,
# and an oversized blob (usually a stray build artifact or dataset). Markers are
# looked for on added lines only, so a file that legitimately holds such a line
# (a test of conflict handling, or a seven-character reStructuredText title
# underlined with `=======`) does not block every later edit to it.
files=$(staged_files)
[ -n "$files" ] || exit 0

max_size=$(cfg_value wits.hooks.pre-commit.sanity-checks-max-file-size 26214400)

rc=0
oldifs=$IFS
IFS='
'
set -f
for file in $files; do
    if [ -L "$file" ] && [ ! -e "$file" ]; then
        log_error "broken symlink: $file -> $(readlink "$file")"
        rc=1
        continue
    fi

    size=$(staged_size "$file")
    if [ -n "$size" ] && [ "$size" -gt "$max_size" ]; then
        log_error "file too large: $file ($((size / 1048576)) MiB > $((max_size / 1048576)) MiB)"
        rc=1
    fi
done
IFS=$oldifs
set +f

# The markers of all three conflict styles, zdiff3's base marker included.
markers=$(staged_added_lines | LC_ALL=C awk -F'\t' '
    $3 ~ /^(<<<<<<<|\|\|\|\|\|\|\||=======|>>>>>>>)( |$)/ { print $1 }' | sort -u)
if [ -n "$markers" ]; then
    printf '%s\n' "$markers" | while IFS= read -r file; do
        log_error "merge-conflict markers in $file"
    done
    rc=1
fi

exit $rc
