#!/bin/sh
# A git credential helper (gitcredentials(7)) answering HTTPS requests with the
# token the configuration keeps for the requested repository, resolved by the
# same ladder wits resolves it by (wits/docs/reference/stack-design.rst,
# "Transport and credentials"), so one secret answers both and never has to
# live in a remote URL. The account is credential.<url>.username, which git
# puts into the request before asking.
#
# Register it per host, as credential.<url>.helper beside that username, so
# only the hosts that opt in are ever asked. Where a token covers less than a
# whole host, register `useHttpPath = true` beside it: git withholds the path
# from a helper without it, and the path-scoped keys then have nothing to match
# on, leaving the helper to answer from the per-host key as it always did.
#
# A request no key answers gets no answer, and falls through to the next helper
# or git's own prompt. store and erase do nothing: the configuration is where a
# token is kept, and the environment is read but never written.

protocol=
host=
path=
while IFS= read -r line && [ -n "$line" ]; do
    case $line in
        protocol=*) protocol=${line#protocol=} ;;
        host=*) host=${line#host=} ;;
        path=*) path=${line#path=} ;;
    esac
done

if [ "$1" != get ] || [ "$protocol" != https ] || [ -z "$host" ]; then
    exit 0
fi

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

host_lc=$(lower "$host")

# The token key scoped to the longest path leading this repository's, or
# nothing when the request carries no path or no key covers it. A key covers
# the request when its host is the request's and its segments lead the
# request's path — whole segments, compared case-insensitively, the way the
# forges themselves compare owners and repositories. Note that git's own URL
# matching compares a path case-sensitively, so a remote spelling an owner in
# another case would miss its token; this is deliberately the looser rule.
#
# The sort is stable and the last line is taken, which selects the longest path
# and, among equals, the key git read last: a later config value overrides an
# earlier one.
scoped_token_key() {
    [ -n "$path" ] || return 0
    # git hands the path over as the URL spells it, `.git` and all, while the
    # path wits matches comes from a parsed remote and carries no such suffix.
    target=$(lower "${path%.git}")
    # git is quiet when a read finds nothing and speaks only when the
    # configuration itself is broken, which is exactly when a token that stopped
    # resolving needs explaining — so no read in this file hides its stderr.
    git config --name-only --get-regexp '^wits\.forge\.[^/]+/.+\.token$' |
        while IFS= read -r name; do
            scope=$(lower "${name#wits.forge.}")
            [ "${scope%%/*}" = "$host_lc" ] || continue
            key_path=${scope%.token}
            key_path=${key_path#*/}
            # A key may spell its path with a trailing slash; it is the same path.
            key_path=${key_path%/}
            [ -n "$key_path" ] || continue
            # Whole segments only, so `ac` does not lead `acme/proj`.
            case "$target/" in "$key_path"/*) ;; *) continue ;; esac
            depth=1
            rest=$key_path
            while [ "$rest" != "${rest#*/}" ]; do
                rest=${rest#*/}
                depth=$((depth + 1))
            done
            printf '%s\t%s\n' "$depth" "$name"
        done |
        sort -s -k1,1n | tail -n 1 | cut -f2-
}

# The service wits attributes to this host: an explicit override first, then
# the host itself. A hand-kept mirror of Service::parse and detect_service in
# wits/crates/wits-util/src/forge/remote.rs — asking wits instead would put a
# built binary on the path of every fetch. The `.ghe.com` arm stays ahead of
# the substring arms, as it does there. wits also folds a few dedicated SSH
# endpoints onto their real domain; this helper only ever sees HTTPS, so there
# is no alias here to fold.
service_of() {
    svc=$(lower "$(git config --get "wits.forge.$1.service")")
    case $svc in
        github | gitlab | gitea | forgejo | codeberg | bitbucket)
            printf '%s' "$svc"
            return
            ;;
    esac
    case $1 in
        github.com | www.github.com) printf github ;;
        gitlab.com | www.gitlab.com) printf gitlab ;;
        codeberg.org | www.codeberg.org) printf codeberg ;;
        bitbucket.org | www.bitbucket.org) printf bitbucket ;;
        *.ghe.com) printf github ;;
        *gitlab*) printf gitlab ;;
        *forgejo*) printf forgejo ;;
        *gitea*) printf gitea ;;
    esac
}

# The token the environment holds for a service, searched as wits searches it:
# a fork falls back to its parent's variable, Codeberg to Forgejo to Gitea.
env_token() {
    case $1 in
        github) set -- GITHUB_TOKEN ;;
        gitlab) set -- GITLAB_TOKEN ;;
        gitea) set -- GITEA_TOKEN ;;
        forgejo) set -- FORGEJO_TOKEN GITEA_TOKEN ;;
        codeberg) set -- CODEBERG_TOKEN FORGEJO_TOKEN ;;
        bitbucket) set -- BITBUCKET_TOKEN ;;
        *) return 1 ;;
    esac
    for name in "$@"; do
        # The names are this function's own literals, never anything read in.
        eval "value=\${$name-}"
        [ -n "$value" ] && {
            printf '%s' "$value"
            return 0
        }
    done
    return 1
}

answer_from_config() {
    value=$(git config --get "$1") || return 1
    [ -n "$value" ] || return 1
    printf 'password=%s\n' "$value"
}

# Most specific first: a key scoped to a path of this repository, then the
# host, then the service, then a blanket key — and only then the environment,
# which is the CI-shaped fallback rather than a place a token is kept.
scoped=$(scoped_token_key)
service=$(service_of "$host_lc")

[ -n "$scoped" ] && answer_from_config "$scoped" && exit 0
answer_from_config "wits.forge.$host.token" && exit 0
[ -n "$service" ] && answer_from_config "wits.forge.$service.token" && exit 0
answer_from_config "wits.forge.token" && exit 0

value=$(env_token "$service") && printf 'password=%s\n' "$value"
exit 0
