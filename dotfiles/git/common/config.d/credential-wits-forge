#!/bin/sh
# A git credential helper (gitcredentials(7)) answering HTTPS requests with the
# token the configuration keeps for the requested host under
# wits.forge.<host>.token, the key wits itself reads, so each secret lives in
# one place and never in a remote URL. The account is credential.<url>.username,
# which git puts into the request before asking.
#
# Register it per host, as credential.<url>.helper beside that username, so
# only the hosts that opt in are ever asked.
#
# A host without that key gets no answer and falls through to the next helper
# or git's own prompt. store and erase do nothing: the configuration is the
# store.

protocol=
host=
while IFS= read -r line && [ -n "$line" ]; do
    case $line in
        protocol=*) protocol=${line#protocol=} ;;
        host=*) host=${line#host=} ;;
    esac
done

if [ "$1" != get ] || [ "$protocol" != https ] || [ -z "$host" ]; then
    exit 0
fi

token=$(git config --get "wits.forge.$host.token") || exit 0
printf 'password=%s\n' "$token"
