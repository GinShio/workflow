# --- distribution baseline
# The distribution's own idea of a development baseline.
@pattern devel_basis

# Build helpers and generators
bison
chrpath
dwarves
flex
graphviz
imake
re2c
xmlto
libxslt-tools

# Version control
git
git-delta
git-doc
git-lfs

# Linting and data
ShellCheck
sqlite3

# Static site generator
hugo

# Grammar runtime the editor modules load at runtime
tree-sitter

# Lua
lua
lua-devel

# --- C and C++
# The distribution's own C/C++ baseline.
@pattern devel_C_C++

# Compilers
clang
clang-devel
clang-doc
clang-extract
clang-tools
gcc
gcc-32bit
gcc-c++
gcc-c++-32bit
gcc-info
llvm
llvm-devel
llvm-doc
llvm-opt-viewer

# Linkers
lld
mold
wild

# Debuggers and coverage
gcovr
gdb
lcov
lldb

# Build systems
cmake
kf6-extra-cmake-modules
meson
ninja

# Compilation caches
ccache
sccache

# Package manager and docs
