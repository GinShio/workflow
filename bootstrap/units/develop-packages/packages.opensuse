# --- TeX
# The whole distribution. A glob, so the engine cannot diff it against what is
# installed and leans on the state record instead — which is the right trade
# for a set this large and this stable.
texlive-*

# --- Emacs
emacs
emacs-nox
emacs-x11

# vterm builds its module against these at first use.
libtool
libvterm-devel
libvterm-tools

