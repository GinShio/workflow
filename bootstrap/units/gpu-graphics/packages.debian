# The SPIR-V translation library is versioned after the LLVM it was built
# against. A glob rather than asking `llvm-config`: the selector stays data,
# and it keeps working across an LLVM major bump.
libllvmspirvlib-*-dev

# Vulkan and SPIR-V
libvulkan-dev
spirv-cross
spirv-tools
