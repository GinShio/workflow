#!/bin/sh
# Agent CLIs published to npm, run under deno rather than node so they do not
# need a node_modules tree or a global npm prefix.

PACKAGES='
    @anthropic-ai/claude-code
    @openai/codex
    @earendil-works/pi-coding-agent
'

_failed=''
for _pkg in $PACKAGES; do
    if ! DENO_INSTALL_ROOT="$HOME/.local/bin" \
            deno install --global -A --allow-scripts "npm:$_pkg"; then
        _failed="$_failed $_pkg"
    fi
done

# The old module reported success no matter what happened here. Collecting the
# failures and exiting non-zero is what lets the run say which package broke
# instead of claiming the whole unit worked.
if [ -n "$_failed" ]; then
    printf 'Failed to install:%s\n' "$_failed" >&2
    exit 1
fi
